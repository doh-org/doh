# 로컬 개발용 환경변수 예시. 실제 값은 backend/.env에 두고 절대 커밋하지 않는다.
# 배포(Fly.io)는 flyctl secrets set으로 주입한다.
ENV=development
PORT=8080
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: RLS 전면 우회 키. 회원 탈퇴(admin delete)에만 사용. 유출 주의.
SUPABASE_SERVICE_ROLE_KEY=
# 네이버 검색 오픈API (developers.naver.com) — 프록시 전용, 앱에 넣지 말 것
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# NCP API Gateway (역지오코딩) — 프록시 전용
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
